			)
		)
	)
	(gr_text "Seen from the front (display side); the F side faces the display.\nThe board rests on the bar and the two top bosses of RB02B_Rear, 7 mm below its rim and 8 mm above\nthe back wall; in RB02B_Rear_GPS the same holes are 19 mm below the rim.\n4 x M2 screws thread into the printed 2 mm pilots.\nThe top edge touches the case wall: keep copper 0.5 mm from it.\nDwgs.User shows the case cut at the board plane."
		(at 103.5 123 0)
		(layer "Cmts.User")
		(uuid "b57ad7e8-49c5-4210-9e8b-a260fd759f9c")
		(effects
			(font
				(size 1.6 1.6)
				(thickness 0.192)
			)
			(justify left top)
		)
	)
	(embedded_fonts no)
