				(size 2.2 2.2)
				(thickness 0.264)
			)
		)
	)
	(gr_text "TOW RELEASE"
		(at 401 230 0)
		(layer "Dwgs.User")
		(uuid "046b3287-e082-465c-862d-6039961427af")
		(effects
			(font
				(size 2.2 2.2)
				(thickness 0.264)
			)
		)
	)
	(gr_text "Seen from the front; the F side faces the back of the panel. Outline = the panel outline.\nCut-outs clear the instrument bodies and display modules by 1 mm: 92 mm squares for the 80 mm RB\ncases, 79 x 85 mm for the 57 mm shells with the GPS hood, display bezel + 2 mm.\nHoles on the panel screws (M4) and the display screws (M3): stand the board off the panel on them.\nSwitches, keys, push-pulls and knobs are drawn on Dwgs.User at their panel cut-outs: place PCB-mount\nparts there, or add cut-outs for panel-mount parts.\nPCB fabs limit the board size (often 500 mm or less): split the board along the print tile seams.\nWarning: display 7.5\" and RB-05 body overlap behind the panel: their cut-outs are merged, check that\nthe two parts clear each other before building."
		(at 97 287 0)
		(layer "Cmts.User")
		(uuid "1672534c-33bd-4f52-bc20-4e73c0f6278d")
		(effects
			(font
				(size 1.6 1.6)
				(thickness 0.192)
			)
			(justify left top)
		)
	)
	(embedded_fonts no)
)
