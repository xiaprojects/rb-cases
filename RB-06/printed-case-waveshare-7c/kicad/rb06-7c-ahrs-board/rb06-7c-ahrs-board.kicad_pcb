	(gr_text "AHRS mark"
		(at 154.899999 74.0094 0)
		(layer "Dwgs.User")
		(uuid "34428dd4-828e-4eb2-93ff-e6dd15160c6a")
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.18)
			)
		)
	)
	(gr_text "Seen from behind, the component side; up is up on the instrument, as the arrow on the plane.\nOutline = the AHRS plane between its engraved marks, 1 mm inside its sides: a 25.4 mm breakout fits\ntoo.\nNo mounting holes: glue the board flat with an epoxy rated above 100 °C, edges square to the arrow.\nParts up to 18 mm tall clear the rear cover.\nWire it to the Pi GPIO, I2C bus 1: 3.3 V pin 1, SDA pin 3, SCL pin 5, GND pin 6. The RB software\nfinds ICM-20948 and MPU-9250 family IMUs at 0x68 and BMP280/388/390 baros at 0x76 or 0x77.\nThe plane is parallel to the panel; set the sensor orientation in the AHRS calibration of the RB\nsoftware.\nDwgs.User shows the carrier cut 0.5 mm in front of its back face, round the AHRS plane."
		(at 123.1 98.6448 0)
		(layer "Cmts.User")
		(uuid "1a81c757-ece9-4947-ae55-6c6701c66a36")
		(effects
			(font
				(size 1.6 1.6)
				(thickness 0.192)
			)
			(justify left top)
		)
	)
	(embedded_fonts no)
)
